{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ojplatform/contracts": ["packages/contracts/src/index.ts"],
      "@ojplatform/core": ["packages/core/src/index.ts"],
      "@ojplatform/judge-protocol": ["packages/judge-protocol/src/index.ts"],
      "@ojplatform/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@ojplatform/test-utils": ["packages/test-utils/src/index.ts"],
      "@ojplatform/api": ["apps/api/src/index.ts"],
      "@ojplatform/database": ["packages/database/src/index.ts"],
      "@ojplatform/cache": ["packages/cache/src/index.ts"],
      "@ojplatform/storage": ["packages/storage/src/index.ts"],
      "@ojplatform/judge-runtime": ["packages/judge-runtime/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "tests/architecture/fixtures/**/*.ts"
  ]
}
