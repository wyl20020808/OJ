# Local development only. Never use these defaults in production.
PORT=3000
HOST=127.0.0.1
OJPLATFORM_CORS_ORIGINS=http://127.0.0.1:5173
OJPLATFORM_ONLINE_CODE_EDITOR_ROOT=../OnlineCodeEditor
DATABASE_URL=postgres://ojplatform:ojplatform_dev@127.0.0.1:55432/ojplatform
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=ojplatform
S3_SECRET_KEY=ojplatform_dev_secret
S3_BUCKET=ojplatform-dev

# Auth V2 provider configuration. Leave unset to expose an honest NOT_CONFIGURED capability.
OJPLATFORM_AUTH_CALLBACK_BASE_URL=http://127.0.0.1:3000
OJPLATFORM_AUTH_SESSION_TTL_MS=604800000
OJPLATFORM_AUTH_REMEMBERED_SESSION_TTL_MS=2592000000
OJPLATFORM_EMAIL_PROVIDER_URL=
OJPLATFORM_EMAIL_PROVIDER_API_KEY=
OJPLATFORM_SMS_PROVIDER_URL=
OJPLATFORM_SMS_PROVIDER_API_KEY=
OJPLATFORM_OAUTH_GOOGLE_CLIENT_ID=
OJPLATFORM_OAUTH_GOOGLE_CLIENT_SECRET=
OJPLATFORM_OAUTH_GITHUB_CLIENT_ID=
OJPLATFORM_OAUTH_GITHUB_CLIENT_SECRET=
OJPLATFORM_OAUTH_WECHAT_CLIENT_ID=
OJPLATFORM_OAUTH_WECHAT_CLIENT_SECRET=
OJPLATFORM_OAUTH_QQ_CLIENT_ID=
OJPLATFORM_OAUTH_QQ_CLIENT_SECRET=

# ── AI capability broker (Stage 6) — all optional. ─────────────────────────────────────────
# AI is optional infrastructure: with nothing below set, the site boots normally and every AI
# capability reports UNAVAILABLE through the broker. Configuration is server-side only; the
# browser never holds an AI Bridge/provider credential or base URL.
#
# Path to the versioned AI Bridge runtime configuration (see config/aibridge.example.json).
# Inline JSON is also accepted via OJPLATFORM_AI_CONFIG_JSON (containers/tests). First one wins:
# OJPLATFORM_AI_CONFIG_JSON, then this file.
OJPLATFORM_AI_CONFIG_FILE=
# Emergency stop: set to 1/true to gate the whole capability broker (DISABLED everywhere).
OJPLATFORM_AI_DISABLED=
# HMAC key for opaque subject tokens (ojs1_/oja1_ namespaces) and for encrypting the transient
# Redis replay cache. Use a long random value; without it subject tokens are process-local
# (unstable across restarts) and the replay cache falls back to the bridge's in-memory store.
OJPLATFORM_AI_SUBJECT_HMAC_KEY=
# Provider credential values referenced by the configuration's credentialRef handles
# (secret://env/<NAME>). Placeholders only — real keys never live in this file.
AIBRIDGE_PRIMARY_GATEWAY_API_KEY=
