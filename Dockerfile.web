# syntax=docker/dockerfile:1

# OnlineCodeEditor remains a separate source repository. Its package lock is
# installed in Linux so Vite resolves its dependencies without host node_modules.
FROM node:22.20.0-alpine AS plugin-dependencies

ARG NPM_REGISTRY=https://registry.npmjs.org
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY
ENV npm_config_registry=$NPM_REGISTRY
WORKDIR /plugin
COPY --from=online-code-editor /package.json /package-lock.json ./
RUN npm ci --omit=dev --registry=$NPM_REGISTRY

FROM node:22.20.0-alpine AS build

ARG NPM_REGISTRY=https://registry.npmjs.org
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY
ENV npm_config_registry=$NPM_REGISTRY
ENV COREPACK_NPM_REGISTRY=$NPM_REGISTRY
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV OJPLATFORM_ONLINE_CODE_EDITOR_ROOT=/plugins/OnlineCodeEditor
WORKDIR /workspace

RUN corepack enable && COREPACK_NPM_REGISTRY=$NPM_REGISTRY corepack install -g pnpm@11.19.0
COPY . .
RUN pnpm install --frozen-lockfile --registry=$NPM_REGISTRY
COPY --from=online-code-editor /src /plugins/OnlineCodeEditor/src
COPY --from=online-code-editor /package.json /plugins/OnlineCodeEditor/package.json
COPY --from=online-code-editor /plugin.manifest.json /plugins/OnlineCodeEditor/plugin.manifest.json
COPY --from=plugin-dependencies /plugin/node_modules /plugins/OnlineCodeEditor/node_modules
RUN pnpm --filter @ojplatform/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY deploy/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
