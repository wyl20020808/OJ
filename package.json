{
  "name": "ojplatform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.20.0 <25"
  },
  "scripts": {
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json eslint.config.mjs vitest.config.ts .prettierrc.json \"{apps,packages,tests}/**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json eslint.config.mjs vitest.config.ts .prettierrc.json \"{apps,packages,tests}/**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "lint": "eslint \"{apps,packages,tests}/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:baseline": "node scripts/ci-test-baseline.mjs",
    "test:architecture": "node tests/architecture/check.mjs",
    "test:e2e": "playwright test",
    "runtime:smoke": "node scripts/runtime-smoke.mjs",
    "infra:up": "node scripts/infra.mjs up -d",
    "infra:down": "node scripts/infra.mjs down",
    "infra:status": "node scripts/infra.mjs ps",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:reset-test": "node scripts/infra.mjs down -v",
    "infra:wait": "node scripts/infra-wait.mjs",
    "migrate:product": "node scripts/migrate.mjs up",
    "migrate:product:status": "node scripts/migrate.mjs status",
    "migrate:product:plan": "node scripts/migrate.mjs plan",
    "migrate:product:adopt": "node scripts/migrate.mjs adopt",
    "migrate:judge": "node scripts/judge-service-migrate.mjs up",
    "migrate:judge:status": "node scripts/judge-service-migrate.mjs status",
    "migrate:judge:plan": "node scripts/judge-service-migrate.mjs plan",
    "migrate:judge:adopt": "node scripts/judge-service-migrate.mjs adopt",
    "test:migrations": "vitest run tests/migration-architecture.test.ts",
    "qualify:migrations": "node scripts/qualify-migration-architecture.mjs",
    "qualify:sandbox-security": "bash tests/security/run-sandbox-security-qualification.sh",
    "qualify:production-judge-config": "node scripts/qualify-production-judge-config.mjs",
    "db:migrate": "pnpm migrate:product",
    "db:rollback": "node scripts/migrate.mjs down",
    "seed:home-development": "node scripts/seed-home-development-fixtures.mjs",
    "seed:problem-library-development": "node scripts/seed-problem-library-development-fixtures.mjs",
    "seed:blog-development": "node scripts/seed-blog-development-fixtures.mjs",
    "seed:evaluation-development": "node scripts/seed-evaluation-development-fixtures.mjs",
    "seed:contest-development": "node scripts/seed-contest-development-fixtures.mjs",
    "cleanup:contest-development": "node scripts/seed-contest-development-fixtures.mjs --cleanup",
    "maintenance:cleanup-generated-problems": "node scripts/cleanup-generated-problems.mjs",
    "integration": "vitest run --config vitest.integration.config.ts",
    "ci:integration": "pnpm infra:up && pnpm infra:wait && pnpm db:migrate && pnpm integration",
    "dev:web": "pnpm --filter @ojplatform/web dev",
    "dev:api": "pnpm --filter @ojplatform/api dev",
    "build:web": "pnpm --filter @ojplatform/web build",
    "build:api": "pnpm --filter @ojplatform/api build",
    "build:api:container": "esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/docker/api-server.mjs",
    "build:judge-service:container": "esbuild apps/judge-service/src/server.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:ioredis --external:pg --external:pg-native --outfile=dist/docker/judge-service-server.mjs",
    "build:judge-migration:container": "esbuild scripts/judge-service-bootstrap.mjs scripts/judge-service-migrate.mjs --bundle --platform=node --format=esm --target=node22 --external:pg --external:pg-native --outdir=dist/scripts",
    "build:host-agent:host": "pnpm --filter @ojplatform/judge-host-agent build:host",
    "test:web": "vitest run tests/web.test.tsx",
    "test:api": "vitest run tests/api.test.ts",
    "ci:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:baseline && pnpm test:architecture && pnpm build",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm ci:check"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@eslint/js": "^9.39.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@ojplatform/contracts": "workspace:*",
    "@ojplatform/core": "workspace:*",
    "@ojplatform/judge-protocol": "workspace:*",
    "@ojplatform/plugin-sdk": "workspace:*",
    "@ojplatform/test-utils": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@sinclair/typebox": "^0.34.52",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.2",
    "vitest": "^4.0.15"
  }
}
