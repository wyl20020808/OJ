# Compose infrastructure development template. Do not use these placeholders in production.
OJPLATFORM_COMPOSE_PROJECT_NAME=ojplatform-infra

POSTGRES_DB=ojplatform
POSTGRES_USER=ojplatform
POSTGRES_PASSWORD=change-me
PRODUCT_RUNTIME_DB_USER=ojplatform_runtime
PRODUCT_RUNTIME_DB_PASSWORD=change-me-runtime
PRODUCT_MIGRATION_DATABASE_URL=postgres://ojplatform:change-me@postgres:5432/ojplatform
PRODUCT_RUNTIME_DATABASE_URL=postgres://ojplatform_runtime:change-me-runtime@postgres:5432/ojplatform

MINIO_ROOT_USER=ojplatform
MINIO_ROOT_PASSWORD=change-me-minio
S3_ACCESS_KEY=ojplatform
S3_SECRET_KEY=change-me-minio
S3_BUCKET=ojplatform-api

OJPLATFORM_POSTGRES_PORT=55432
OJPLATFORM_REDIS_PORT=56379
OJPLATFORM_MINIO_PORT=59000
OJPLATFORM_MINIO_CONSOLE_PORT=59001
OJPLATFORM_API_PORT=3010

# Optional Judge migration profile only. Judge runtime remains outside Phase 3.
JUDGE_DATABASE_ADMIN_URL=
JUDGE_DATABASE_URL=
JUDGE_DATABASE_NAME=ojplatform_judge
JUDGE_DATABASE_ROLE=ojplatform_judge_runtime
JUDGE_DATABASE_PASSWORD=
