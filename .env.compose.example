# Compose infrastructure development template. Do not use these placeholders in production.
OJPLATFORM_COMPOSE_PROJECT_NAME=ojplatform-infra

POSTGRES_DB=ojplatform
POSTGRES_USER=ojplatform
POSTGRES_PASSWORD=change-me
PRODUCT_RUNTIME_DB_USER=ojplatform_runtime
PRODUCT_RUNTIME_DB_PASSWORD=change-me-runtime
PRODUCT_MIGRATION_DATABASE_URL=postgres://ojplatform:change-me@postgres:5432/ojplatform
PRODUCT_RUNTIME_DATABASE_URL=postgres://ojplatform_runtime:change-me-runtime@postgres:5432/ojplatform

MINIO_ROOT_USER=ojplatform
MINIO_ROOT_PASSWORD=change-me-minio
S3_ACCESS_KEY=ojplatform
S3_SECRET_KEY=change-me-minio
S3_BUCKET=ojplatform-api

OJPLATFORM_POSTGRES_PORT=55432
OJPLATFORM_REDIS_PORT=56379
OJPLATFORM_MINIO_PORT=59000
OJPLATFORM_MINIO_CONSOLE_PORT=59001
OJPLATFORM_API_PORT=3010
OJPLATFORM_WEB_PORT=5173

# Path to a separate OnlineCodeEditor checkout. This is a host build input only;
# Docker normalizes it to /plugins/OnlineCodeEditor during the build.
# Set an absolute or relative path valid on your operating system.
OJPLATFORM_ONLINE_CODE_EDITOR_CONTEXT=../OnlineCodeEditor

# Optional Judge control-plane profile. Supply strong, distinct credentials at
# runtime; never commit populated values. Worker/Host Agent/Supervisor remain
# host-side. The host execution cell reaches Judge Service through loopback.
OJPLATFORM_JUDGE_SERVICE_PORT=3100
JUDGE_DATABASE_ADMIN_URL=
JUDGE_MIGRATION_DATABASE_URL=
JUDGE_RUNTIME_DATABASE_URL=
JUDGE_DATABASE_NAME=ojplatform_judge
JUDGE_DATABASE_ROLE=ojplatform_judge_runtime
JUDGE_DATABASE_PASSWORD=
# Compose-only endpoint consumed by API. Host Workers must instead use
# JUDGE_SERVICE_URL=http://127.0.0.1:${OJPLATFORM_JUDGE_SERVICE_PORT}.
JUDGE_SERVICE_INTERNAL_URL=http://judge-service:3100
JUDGE_SERVICE_TOKEN=
JUDGE_NODE_TOKEN=
JUDGE_REDIS_PREFIX=oj:judge-service
