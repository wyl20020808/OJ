# OJPlatform production environment template.
#
# Usage:
#   cp .env.production.example .env
#   $EDITOR .env          # replace every <...> placeholder
#
# Rules:
#   - This file is the single source of deployment values. `deploy/judge-host/install.sh`
#     derives the host-native execution-cell configuration from the same file.
#   - Never commit the filled `.env`. It is Git-ignored.
#   - Every value marked REQUIRED has no safe default; `compose.prod.yaml` refuses to
#     render while any of them is unset. Values below are placeholders, not secrets.
#   - Generate strong values, e.g. `openssl rand -base64 48 | tr -d '\n=+/'`.
#   - Passwords appear inside `redis://` and `postgres://` URLs, so keep them
#     URI-safe (base64url or alphanumeric).

# ---------------------------------------------------------------------------
# Project identity (OPTIONAL)
# ---------------------------------------------------------------------------
OJPLATFORM_COMPOSE_PROJECT_NAME=ojplatform

# ---------------------------------------------------------------------------
# Product PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
POSTGRES_DB=ojplatform
POSTGRES_USER=ojplatform
POSTGRES_PASSWORD=<set-strong-random-value>
PRODUCT_RUNTIME_DB_USER=ojplatform_runtime
PRODUCT_RUNTIME_DB_PASSWORD=<set-strong-random-value>

# One-shot migration identity; may be the bootstrap superuser.
PRODUCT_MIGRATION_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Runtime identity; used by the API container.
PRODUCT_RUNTIME_DATABASE_URL=postgres://${PRODUCT_RUNTIME_DB_USER}:${PRODUCT_RUNTIME_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---------------------------------------------------------------------------
# Judge PostgreSQL (REQUIRED when using --profile judge)
# ---------------------------------------------------------------------------
JUDGE_DATABASE_NAME=ojplatform_judge
JUDGE_DATABASE_ROLE=ojplatform_judge_runtime
JUDGE_DATABASE_PASSWORD=<set-strong-random-value>
# One-shot bootstrap: an admin connection to the maintenance database.
JUDGE_DATABASE_ADMIN_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/postgres
JUDGE_MIGRATION_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${JUDGE_DATABASE_NAME}
JUDGE_RUNTIME_DATABASE_URL=postgres://${JUDGE_DATABASE_ROLE}:${JUDGE_DATABASE_PASSWORD}@postgres:5432/${JUDGE_DATABASE_NAME}

# ---------------------------------------------------------------------------
# Redis ACL identities (REQUIRED, all distinct)
# ---------------------------------------------------------------------------
# The admin identity is used only by the one-shot ACL bootstrap. It is never
# handed to API, Judge Service, or the Worker.
REDIS_ADMIN_USERNAME=oj-admin
REDIS_ADMIN_PASSWORD=<set-strong-random-value>
REDIS_PRODUCT_USERNAME=oj-product
REDIS_PRODUCT_PASSWORD=<set-strong-random-value>
REDIS_JUDGE_USERNAME=oj-judge-service
REDIS_JUDGE_PASSWORD=<set-strong-random-value>
REDIS_WORKER_USERNAME=oj-judge-worker
REDIS_WORKER_PASSWORD=<set-strong-random-value>
REDIS_HEALTH_USERNAME=oj-redis-health
REDIS_HEALTH_PASSWORD=<set-strong-random-value>
JUDGE_REDIS_PREFIX=oj:judge-service

# ---------------------------------------------------------------------------
# Object storage (REQUIRED)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=ojplatform-minio-root
MINIO_ROOT_PASSWORD=<set-strong-random-value>
S3_ACCESS_KEY=ojplatform-product
S3_SECRET_KEY=<set-strong-random-value>
S3_BUCKET=ojplatform-api
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Service and node tokens (REQUIRED, all distinct, >= 32 chars)
# ---------------------------------------------------------------------------
# API <-> Judge Service service protocol.
JUDGE_SERVICE_TOKEN=<set-strong-random-value>
# Judge Service <-> Worker node protocol.
JUDGE_NODE_TOKEN=<set-strong-random-value>
# Read-only Product artifact transport used by the Worker.
JUDGE_ARTIFACT_READ_TOKEN=<set-strong-random-value>
# Worker <-> local Supervisor artifact staging. Consumed by host services only.
OJPLATFORM_SUPERVISOR_ARTIFACT_TOKEN=<set-strong-random-value>
# Judge Host Agent control API. Consumed by host services only.
JUDGE_HOST_AGENT_TOKEN=<set-strong-random-value>

# ---------------------------------------------------------------------------
# Public ingress and loopback ports (OPTIONAL)
# ---------------------------------------------------------------------------
# Only Web is publicly reachable. Everything else stays on host loopback for
# same-host native services, or stays private to the Compose network.
OJPLATFORM_WEB_PORT=8080
OJPLATFORM_API_INTERNAL_PORT=3010
OJPLATFORM_JUDGE_SERVICE_PORT=3100
OJPLATFORM_REDIS_WORKER_PORT=6379

# ---------------------------------------------------------------------------
# OnlineCodeEditor (OPTIONAL)
# ---------------------------------------------------------------------------
# Host-side build input for the Web image only. Defaults to the pinned
# `plugins/OnlineCodeEditor` submodule, so a normal deployment does not set
# this. Use it only to build against a custom plugin checkout. It never
# enters the image and is not needed for Core-only or Judge-only operations.
# See Docs/deployment/FRESH_MACHINE_DEPLOYMENT.md.
# OJPLATFORM_ONLINE_CODE_EDITOR_CONTEXT=./plugins/OnlineCodeEditor

# ---------------------------------------------------------------------------
# Immutable image references (OPTIONAL; recommended for production)
# ---------------------------------------------------------------------------
# OJPLATFORM_API_IMAGE=registry.example/ojplatform/api:1.0.0
# OJPLATFORM_WEB_IMAGE=registry.example/ojplatform/web:1.0.0
# OJPLATFORM_JUDGE_SERVICE_IMAGE=registry.example/ojplatform/judge-service:1.0.0
# OJPLATFORM_JUDGE_MIGRATION_IMAGE=registry.example/ojplatform/judge-migration:1.0.0

# ---------------------------------------------------------------------------
# Execution cell (OPTIONAL; host-native, not Compose services)
# ---------------------------------------------------------------------------
# Node identity registered with Judge Service, and per-host job concurrency.
OJ_JUDGE_NODE_ID=judge-node-1
MAX_CONCURRENCY=1
