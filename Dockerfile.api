# API image stays at repository root because the build needs root workspace and
# migration files; this avoids copying unrelated local plugin worktrees.
FROM node:22.20.0-alpine AS build

ARG NPM_REGISTRY=https://registry.npmjs.org
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY
ENV npm_config_registry=$NPM_REGISTRY
ENV COREPACK_NPM_REGISTRY=$NPM_REGISTRY
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN corepack enable && COREPACK_NPM_REGISTRY=$NPM_REGISTRY corepack install -g pnpm@11.19.0
COPY . .
RUN pnpm install --frozen-lockfile --registry=$NPM_REGISTRY
RUN pnpm build && pnpm build:api:container
RUN pnpm deploy --config.registry=$NPM_REGISTRY --legacy --filter @ojplatform/api --prod /runtime

FROM node:22.20.0-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S ojplatform && adduser -S -G ojplatform ojplatform

COPY --from=build --chown=ojplatform:ojplatform /runtime/node_modules ./node_modules
COPY --from=build --chown=ojplatform:ojplatform /workspace/dist/docker/api-server.mjs ./dist/api-server.mjs
COPY --from=build --chown=ojplatform:ojplatform /workspace/scripts/migrate.mjs ./scripts/migrate.mjs
COPY --from=build --chown=ojplatform:ojplatform /workspace/scripts/migration-runner.mjs ./scripts/migration-runner.mjs
COPY --from=build --chown=ojplatform:ojplatform /workspace/scripts/judge-service-bootstrap.mjs ./scripts/judge-service-bootstrap.mjs
COPY --from=build --chown=ojplatform:ojplatform /workspace/scripts/judge-service-migrate.mjs ./scripts/judge-service-migrate.mjs
COPY --from=build --chown=ojplatform:ojplatform /workspace/scripts/migrations ./scripts/migrations
COPY --from=build --chown=ojplatform:ojplatform /workspace/packages/database/migrations ./packages/database/migrations

USER ojplatform
EXPOSE 3010
CMD ["node", "dist/api-server.mjs"]
