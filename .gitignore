.env
.env.*
!.env.example
!.env.compose.example
!.env.production.example

# OnlineCodeEditor is a pinned Git submodule: OJPlatform commits only the
# gitlink, never the plugin's files. The wildcard keeps an accidental stray
# checkout out of the repository, while the explicit exception lets the
# submodule gitlink be tracked.
plugins/*
!plugins/README.md
!plugins/OnlineCodeEditor

node_modules/
dist/
build/
coverage/
test-results/

*.log

.idea/
.vscode/
.DS_Store
Thumbs.db

tmp/
temp/

secrets/
.runtime/
config/dev-runtime.local.ps1
